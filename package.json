{
  "name": "accessible-rn-components",
  "version": "1.0.0",
  "main": "index.ts",
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.78"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@expo/metro-runtime": "~58.0.14",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-native-web-vite": "^10.6.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "expo": "~58.0.7",
    "expo-status-bar": "~57.0.1",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.9",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-web": "^0.21.2",
    "storybook": "^10.6.2",
    "test-renderer": "^1.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "mutation-check": "python3 scripts/mutation-check.py",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "a11y-audit": "npm run build-storybook && node scripts/a11y-audit.mjs",
    "keyboard-check": "npm run build-storybook && node scripts/keyboard-check.mjs",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.stories.{ts,tsx}",
      "!src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "description": "Accessible React Native components with WCAG-checked design tokens, tested with Testing Library.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{js,mjs,json,yml}": "prettier --write"
  }
}
